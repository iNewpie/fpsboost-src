{
  "name": "fpsboost",
  "version": "0.2.0",
  "description": "Windows network + FPS optimizer with a subscription",
  "private": true,
  "main": "out/main.js",
  "scripts": {
    "start": "node scripts/build.js && electron .",
    "test": "node --test",
    "build": "node scripts/build.js",
    "dist": "electron-builder --win nsis --x64",
    "demo": "node dev/gen.js"
  },
  "devDependencies": {
    "bytenode": "^1.7.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "ir.fpsboost.app",
    "productName": "FPS Boost",
    "files": [
      "out/**",
      "package.json",
      "build/icon.png",
      "!node_modules/bytenode/{README.md,CHANGELOG.md,lib/cli.js,cli.js,.github}"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FPSBoost-Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "FPS Boost",
      "differentialPackage": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "asar": true,
    "compression": "normal",
    "electronLanguages": [
      "en-US",
      "fa"
    ],
    "beforePack": "scripts/beforePack.js",
    "afterPack": "scripts/afterPack.js",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false
    }
  },
  "dependencies": {
    "bytenode": "^1.5.6"
  }
}

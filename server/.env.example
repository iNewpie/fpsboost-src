# copy to server/.env (git-ignored) and fill in
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ADMIN_USER=admin
ADMIN_PASS=
# from zarinpal.com after registering the merchant (36 characters); empty = buying is disabled
ZARINPAL_MERCHANT=
# generated by deploy.sh on first run
SESSION_SECRET=
# Ed25519 private key (base64 PKCS8) that signs the desktop app's answers — the matching public key is app/src/config.js SERVER_PUBKEY.
# New pair: node -e "const c=require('crypto'),{publicKey,privateKey}=c.generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'der'}).toString('base64'));console.log(publicKey.export({type:'spki',format:'der'}).toString('base64'))"
APP_SIGN_KEY=
